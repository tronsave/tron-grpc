{
  "name": "tron-grpc",
  "version": "3.0.1",
  "description": "A TypeScript client for interacting with the TRON blockchain via gRPC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tronsave/tron-grpc.git"
  },
  "homepage": "https://github.com/tronsave/tron-grpc#readme",
  "bugs": {
    "url": "https://github.com/tronsave/tron-grpc/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "sync-proto": "tsx scripts/sync-proto.ts",
    "update-proto": "npm run sync-proto",
    "build": "npm run clean && tsc --project tsconfig.json && npm run copy-proto",
    "copy-proto": "mkdir -p dist/src/proto/contract && find src/proto -maxdepth 1 -name '*.proto' -exec cp {} dist/src/proto/ \\; && cp src/proto/contract/*.proto dist/src/proto/contract/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "tsx test.ts",
    "test:unit": "node --test test/unit.test.mjs",
    "test:live": "node --test --test-timeout=120000 test/live.test.mjs",
    "test:nile": "node --env-file-if-exists=.env --test --test-timeout=600000 test/nile.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:unit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "protobufjs": "^7.6.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
